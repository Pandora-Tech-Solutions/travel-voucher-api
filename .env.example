# ==============================
# Application
# ==============================
# Porta em que a API vai rodar (default: 3000)
PORT=3000

# URL base da aplicação (usada nos links enviados por e-mail, ex.: reset de senha)
APP_URL=http://localhost:3000

# ==============================
# Database (MongoDB)
# ==============================
# String de conexão do MongoDB
# Ex. local (docker-compose): mongodb://root:root@localhost:27017/laike-travel-voucher_db?authSource=admin
DB_CONNECTION_STRING=mongodb://root:root@localhost:27017/laike-travel-voucher_db?authSource=admin

# ==============================
# Auth
# ==============================
# Segredo usado para assinar/validar os tokens JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Salt usado no hash das senhas dos usuários
PASSWORD_SALT=change-me-to-a-random-salt

# ==============================
# Mail (SMTP - mail.laiketurismo.com.br:465)
# ==============================
# Usuário e senha do servidor SMTP
MAIL_LOGIN=
MAIL_PASS=

# Remetente padrão dos e-mails
MAIL_FROM=no-reply@laiketurismo.com.br

# Destinatário padrão para e-mails (ex.: notificações internas)
MAIL_TO=
